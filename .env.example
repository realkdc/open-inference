HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./.data/open-inference.sqlite
DOMAIN=api.example.org

# Set a high-entropy admin token (at least 32 characters) to create invitations.
OPENINFERENCE_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Private route: point this at a model endpoint operated by the Open Inference service.
# The gateway does not fall back to community nodes if this endpoint is unavailable.
PRIVATE_UPSTREAM_URL=
PRIVATE_UPSTREAM_API_KEY=

# Community route: create an invite token for the MeshLLM community mesh.
MESHLLM_INVITE_TOKEN=
# Keep community serving disabled until every mesh node enforces the verified
# owner-admission policy you require. A join token is not an access-control check.
MESHLLM_ADMISSION_POLICY_VERIFIED=false
# Optional service Owner IDs, such as a separate bootstrap host. The gateway
# Owner ID is included automatically; add/revoke contributors in /operator.
MESHLLM_TRUSTED_OWNER_IDS=
# If unset, the gateway creates and stores its MeshLLM identity under MESHLLM_OWNER_KEY_PATH.
MESHLLM_OWNER_KEYPAIR_HEX=
MESHLLM_OWNER_KEY_PATH=./.data/community-mesh-owner-key
# Optional local MeshLLM management API used only for the admin pool dashboard.
# This must be loopback HTTP; never expose the raw management API to the internet.
MESHLLM_MANAGEMENT_URL=http://127.0.0.1:10338

PRIVATE_DAILY_LIMIT_UNITS=5000
COMMUNITY_DAILY_LIMIT_UNITS=5000
# Provisional community allowances; tune after measuring real pool capacity.
CONTRIBUTOR_COMMUNITY_DAILY_LIMIT_UNITS=15000
SUSTAINER_COMMUNITY_DAILY_LIMIT_UNITS=50000
PRIVATE_MAX_CONCURRENT=1
COMMUNITY_MAX_CONCURRENT=1
MAX_QUEUED_REQUESTS=20
QUEUE_TIMEOUT_MS=60000
MAX_CONTEXT_TOKENS=2048
MAX_INPUT_TOKENS=1536
DEFAULT_MAX_COMPLETION_TOKENS=512
HARD_MAX_COMPLETION_TOKENS=1024
# Optional model-specific compute weights, for example {"small-model":0.5,"large-model":3}
MODEL_COMPUTE_WEIGHTS={}

# Optional: restrict dashboard browser access to an explicit origin.
# DASHBOARD_ORIGIN=https://app.example.com
# Set when a reverse proxy terminates TLS or serves a public hostname.
# PUBLIC_BASE_URL=https://api.example.com
